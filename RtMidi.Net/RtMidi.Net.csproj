<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- LibraryImport (source-generated P/Invoke) and function pointers for the native callback -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>

        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/Daniel127/RtMidi.Net</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Daniel127/RtMidi.Net</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>MIDI;RtMidi;realtime;audio;music;ALSA;CoreMIDI;WinMM</PackageTags>
        <Authors>Daniel Quiñones</Authors>
        <Description>.NET wrapper for RtMidi: realtime MIDI input and output on Windows, Linux (including Raspberry Pi) and macOS. Includes the native RtMidi libraries.</Description>

        <!-- XML docs (IntelliSense) for every target framework in the package -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Missing or broken XML docs fail the build: CS1591 undocumented public member, CS1573 missing param,
             CS1572 param that does not exist, CS1574 unresolved cref, CS1570 badly formed XML -->
        <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1574;CS1591</WarningsAsErrors>

        <!-- Debugging: symbol package (.snupkg) with Source Link to the GitHub commit -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- Checks the package (e.g. same public API in every target framework) when packing -->
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RtMidi.Net.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LICENSE.md" Pack="true" PackagePath="/" />
        <None Include="..\README.md" Pack="true" PackagePath="/" />
        <None Include="..\assets\icon.png" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <!--
      Native RtMidi libraries built by CI from the external/rtmidi submodule.
      Expected layout: $(RtMidiNativeDir)<rid>/native/<library>
      They are packed as runtimes/<rid>/native/<library>, so the .NET runtime
      picks the right one for the platform automatically.
    -->
    <PropertyGroup>
        <RtMidiNativeDir Condition="'$(RtMidiNativeDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\native\</RtMidiNativeDir>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(RtMidiNativeDir)**\*" Pack="true" PackagePath="runtimes" Visible="false" />
    </ItemGroup>
</Project>
